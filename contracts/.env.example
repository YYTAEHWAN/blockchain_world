# Sepolia 테스트넷 배포용 환경변수 예시
# 실제 값은 .env 파일에 넣고, .env는 절대 커밋하지 않습니다 (.gitignore 처리됨)

# Infura 또는 Alchemy 등에서 발급받은 Sepolia RPC URL
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# 배포용 계정 개인키 (반드시 테스트넷 전용 계정 사용, 실제 자산 있는 지갑 금지)
PRIVATE_KEY=your_test_account_private_key_without_0x_prefix
